-- Hop đúng server 1 người
local function HopServer()
    Hop.Text = "🔎 ĐANG TÌM SERVER 1 NGƯỜI..."

    local Success, Result = pcall(function()
        return HttpService:JSONDecode(
            game:HttpGet(
                "https://games.roblox.com/v1/games/"
                .. PlaceId ..
                "/servers/Public?sortOrder=Asc&limit=100"
            )
        )
    end)

    if not Success or not Result or not Result.data then
        Hop.Text = "❌ KHÔNG LẤY ĐƯỢC SERVER"
        task.wait(2)
        Hop.Text = "👤 HOP SERVER 1 NGƯỜI"
        return
    end

    local Targets = {}

    for _, Server in ipairs(Result.data) do
        -- ĐÚNG 1 NGƯỜI và không phải server hiện tại
        if Server.id ~= game.JobId
        and Server.playing == 1
        and Server.playing < Server.maxPlayers then
            table.insert(Targets, Server)
        end
    end

    if #Targets == 0 then
        Hop.Text = "❌ KHÔNG CÓ SERVER 1 NGƯỜI"
        task.wait(2)
        Hop.Text = "👤 HOP SERVER 1 NGƯỜI"
        return
    end

    local Target = Targets[math.random(1,#Targets)]

    Hop.Text = "🚀 ĐANG VÀO SERVER 1 NGƯỜI..."

    TeleportService:TeleportToPlaceInstance(
        PlaceId,
        Target.id,
        Player
    )
end

Hop.MouseButton1Click:Connect(HopServer)

print("💗 PHN HUB - HOP 1 PLAYER LOADED")
